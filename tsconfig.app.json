{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // No "baseUrl". It is deprecated and stops working in TypeScript 7.0.
    // Since TS 5.0 a non-relative "paths" entry resolves against the directory
    // holding this file, so the leading "./" is doing the job baseUrl used to.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
